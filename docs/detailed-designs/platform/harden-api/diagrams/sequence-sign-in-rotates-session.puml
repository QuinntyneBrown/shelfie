@startuml
title UML sequence behaviour — Sign-in rotates the session id
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Grown-up" as actor
box "Frontend — Shelfie web (sign-in library)" #E0F2FE
  participant "SignInPage" as page
  participant "AuthApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "sessionMiddleware\n+ csrfGuard" as mw
  participant "passwordSignInLimiter" as rate
  participant "auth.router.ts\n+ validate(passwordSignInSchema)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "auth.service.ts" as service
  participant "hashing.ts" as hashing
  participant "session.ts\nissueSession" as issue
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (SQLite)" as db
end box

actor -> page : Submit e-mail and password
page -> client : signInWithPassword(email, password)
client -> mw : POST /api/auth/password\n(cookie shelfie_session may be present)
mw -> db : SELECT session WHERE id = ?
db --> mw : row or none
mw -> rate : next()
alt more than 10 attempts from this IP in 10 minutes
  rate --> client : 429 Problem type "rate-limited", Retry-After (L2-027)
  client --> page : ApiError
  page --> actor : "Too many tries" message
else within the limit
  rate -> router : next()
  router -> router : Validate body: email format, password non-empty (L2-028)
  router -> service : signInWithPassword(email, password)
  service -> db : SELECT profile WHERE email = ? AND role = 'grown_up'
  db --> service : profile row with password_hash
  service -> hashing : verifySecret(password_hash, password)
  hashing --> service : match or no match (argon2id — L2-027)
  alt no match or no such profile
    service --> router : HttpError 401 type "credentials-invalid"
    router --> client : 401 Problem {requestId}
    client --> page : ApiError
    page --> actor : Generic "e-mail or password is wrong"
  else match
    service -> issue : issueSession(res, profileId)
    issue -> db : DELETE FROM session WHERE id = ? (old cookie id, if any)
    issue -> db : INSERT session (id = random 128-bit, profile_id, expires_at)
    db --> issue : new row
    issue --> service : Session
    service --> router : Session
    router --> client : 200 {session}\nSet-Cookie shelfie_session=newId; HttpOnly; Secure; SameSite=Strict (L2-027)\nCache-Control: no-store
    client --> page : Session
    page --> actor : Navigate to /review
  end
end
@enduml
