@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Operate the service

Container(web, "Shelfie web", "Angular", "ApiClient maps errors to ApiError{status, problem}; server-error page shows problem.requestId")
System_Ext(scheduler, "cron on the VM", "08:15 UTC")
Container_Boundary(api, "Shelfie API") {
  Component(context, "requestContext", "Middleware (logger.ts)", "Generates requestId SHF-XXXX; sets req.context and X-Request-Id")
  Component(logger, "logger", "pino (logger.ts)", "One line per request: requestId, method, route, status, durationMs")
  Component(app, "app.ts", "Express app", "Mounts requestContext first and problemDetailsHandler last")
  Component(health, "health.router.ts", "Express Router", "GET /api/health: SELECT 1 then 200 or 503")
  Component(routers, "Feature routers", "Express Routers", "Mounted under /api")
  Component(errors, "errors.ts", "Error handler", "problemDetailsHandler: logs unhandled error with requestId; 500 generic body with requestId")
  Component(dbmod, "db.ts", "pg Pool", "max 10, TLS verified in production; migrate() applies migrations/*.sql with indexes")
  ComponentDb(db, "Shelfie database", "PostgreSQL 16", "Flexible server in the private subnet")
}
Container_Boundary(job, "Nightly job") {
  Component(backup, "backup.sh", "Host script", "node purge.ts; pg_dump --format=custom; upload to the backups container")
}
Rel(web, app, "JSON/HTTPS requests")
Rel(app, context, "Applies first")
Rel(context, logger, "Writes the request line on finish")
Rel(app, health, "Mounts GET /api/health")
Rel(app, routers, "Mounts under /api")
Rel(app, errors, "Applies last")
Rel(errors, logger, "logger.error({requestId, err})")
Rel(health, dbmod, "SELECT 1")
Rel(routers, dbmod, "Parameterised statements")
Rel(dbmod, db, "Reads and writes", "SQL")
Rel(scheduler, backup, "Runs nightly")
Rel(backup, db, "pg_dump", "TLS")
@enduml
