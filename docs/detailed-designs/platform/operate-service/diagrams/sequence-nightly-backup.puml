@startuml
title UML sequence behaviour — Nightly backup
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "cron\n(/etc/cron.d/shelfie-backup)" as scheduler
box "Backend — VM host scripts" #ECFDF3
  participant "backup.sh" as job
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  participant "pg_dump" as dump
  database "Shelfie database (PostgreSQL)" as db
  participant "Blob Storage (backups)" as blobs
  participant "journald (shelfie-backup)" as log
end box

scheduler -> job : /usr/local/bin/shelfie-backup at 08:15 UTC
job -> job : node apps/api/src/purge.ts (expired rows)
job -> dump : pg_dump "$DATABASE_URL" --format=custom --file=tmp
dump -> db : read schema and rows over TLS (L2-031)
alt dump succeeds
  db --> dump : rows
  dump --> job : tmp written
  job -> blobs : PUT shelfie-YYYY-MM-DD.dump (managed identity)
  blobs --> job : 201 Created
  job -> log : uploaded shelfie-YYYY-MM-DD.dump
  job --> scheduler : exit 0
else dump or upload fails
  dump --> job : non-zero exit
  job -> log : error line
  job --> scheduler : exit 1 (earlier dumps untouched)
end
note over blobs
  A lifecycle rule deletes dumps 30 days after their last
  modification; the managed server keeps 7 days of
  point-in-time restore on its own (docs/runbook.md)
end note
@enduml
