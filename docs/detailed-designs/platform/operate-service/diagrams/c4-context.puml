@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Operate the service

Person(reader, "Reader", "Child who logs chapters on a phone")
Person(grownUp, "Parent", "Parent who reviews answers and operates the service")
System(shelfie, "Shelfie", "Reading log and comprehension questions for many households")
