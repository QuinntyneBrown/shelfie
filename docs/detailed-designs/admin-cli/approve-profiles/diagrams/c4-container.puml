@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Approve profiles

Person(operator, "Operator")
Container(cli, "shelfie-admin", ".NET 10, System.CommandLine", "profiles list | approve <id> | hide <id> [--dry-run] [--json]")
System_Boundary(shelfie, "Shelfie") {
  Container(api, "Shelfie API", "Node.js, Express", "/api/admin/v1/profiles, /profiles/:id/approve, /profiles/:id/hide")
  ContainerDb(db, "Shelfie database", "PostgreSQL 16", "profile, directory_profile, catalogue_book, admin_token, admin_audit")
}
Rel(operator, cli, "Types commands")
Rel(cli, api, "GET and POST with Authorization: Bearer", "JSON/HTTPS")
Rel(api, db, "Reads profiles; updates status; writes audit", "SQL")
@enduml
