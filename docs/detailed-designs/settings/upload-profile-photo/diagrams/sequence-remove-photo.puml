@startuml
title UML sequence behaviour — Remove a photo
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Parent or reader" as person
box "Frontend — Shelfie web" #E0F2FE
  participant "ProfilePhotoDialog\n+ sh-photo-picker" as dialog
  participant "ProfilePhotoApi" as client
  participant "SessionService" as session
end box
box "Backend — Shelfie API" #D1FADF
  participant "photos.router.ts\n+ csrfGuard, requireSession" as router
  participant "photos.service.ts\n(sharp)" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box
person -> dialog : Remove photo
dialog -> dialog : Set busy
dialog -> client : remove()
client -> router : DELETE /api/profile/photo (X-Requested-With: Shelfie)
router -> router : Session required (401); CSRF (403)
router -> service : removePhoto(session.profileId)
service -> db : DELETE FROM profile_photo WHERE profile_id = ?
alt failure
  router --> client : 500 problem
  client --> dialog : ApiError
  dialog --> person : Show the danger banner; the photo stays
else removed
  router --> client : 204
  dialog -> session : update({photo: null})
  dialog --> person : Preview and top bar show the initial again (L2-042)
end
@enduml
