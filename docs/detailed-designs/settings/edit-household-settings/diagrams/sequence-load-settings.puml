@startuml
title UML sequence behaviour — Load settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Grown-up" as grownUp
box "Frontend — Shelfie web (settings library)" #E0F2FE
  participant "SettingsPage" as page
  participant "SettingsApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "settings.router.ts\n+ requireRole('grown-up')" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "settings.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (SQLite)" as db
end box

grownUp -> page : Open /settings (grownUpGuard)
page -> page : Show loading skeleton
page -> client : get()
client -> router : GET /api/settings
router -> router : Load session; require grown-up role
router -> service : getSettings(householdId)
service -> db : SELECT profile rows and household.theme WHERE household_id = ?
alt database or network failure
  db --> service : error
  service --> router : throws
  router --> client : 500 problem {requestId}
  client --> page : ApiError
  page --> grownUp : Show error state "Settings did not load" with Try again
  grownUp -> page : Try again
  page -> client : get()
else rows found
  db --> service : reader row, grown-up row, theme
  service --> router : SettingsView
  router --> client : 200 {reader, grownUp, theme}
  client --> page : SettingsView
  page --> grownUp : Render Reader, Grown-up and Appearance sections (L2-021)
end
@enduml
