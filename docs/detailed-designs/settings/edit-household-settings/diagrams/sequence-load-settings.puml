@startuml
title UML sequence behaviour — Load settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as parent
box "Frontend — Shelfie web (settings library)" #E0F2FE
  participant "SettingsPage" as page
  participant "SettingsApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "settings.router.ts\n+ requireRole('parent')" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "settings.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

parent -> page : Open /settings (parent guard)
page -> page : Show loading skeleton
page -> client : get()
client -> router : GET /api/settings
router -> router : Load session; require parent role
router -> service : getSettings(householdId, userId)
service -> db : SELECT user row and household.theme WHERE household_id = ?
alt database or network failure
  db --> service : error
  service --> router : throws
  router --> client : 500 problem {requestId}
  client --> page : ApiError
  page --> parent : Show error state "Settings did not load" with Try again
  parent -> page : Try again
  page -> client : get()
else rows found
  db --> service : parent row, theme
  service --> router : SettingsView
  router --> client : 200 {account, theme}
  client --> page : SettingsView
  page --> parent : Render Your account and Appearance sections (L2-021)
end
@enduml
