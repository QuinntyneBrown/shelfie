@startuml
title UML sequence behaviour — Save settings
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as parent
box "Frontend — Shelfie web (settings library)" #E0F2FE
  participant "SettingsPage" as page
  participant "SettingsApi" as client
  participant "SessionService" as session
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "settings.router.ts\n+ validate(settingsPatchSchema)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "settings.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

parent -> page : Edit fields; tap Save settings
page -> page : Client checks: password 8+ and equal in both boxes,\nname 1-40, e-mail format (L2-021)
alt a client check fails
  page --> parent : Show "Fix N things" summary and field errors; keep values; send nothing
else checks pass
  page -> page : Set submitting; disable form
  page -> client : save(patch)
  client -> router : PATCH /api/settings {account, theme}
  router -> router : Require parent role; validate body (400 errors[] on failure)
  router -> service : updateSettings(householdId, userId, patch)
  service -> db : SELECT user WHERE id = ?
  db --> service : parent row
  alt e-mail or password changes and currentPassword missing or wrong
    service -> service : argon2id verify currentPassword against password_hash (L2-021)
    service --> router : CurrentPasswordInvalid
    router --> client : 400 problem type "current-password-invalid"
    client --> page : ApiError
    page --> parent : Error under Current password; keep values (L2-021)
  else e-mail already registered to another user
    service -> db : SELECT user WHERE email = ?
    db --> service : other user
    service --> router : EmailInUse
    router --> client : 409 problem type "email-in-use"
    client --> page : ApiError
    page --> parent : Error under E-mail address; keep values
  else all checks pass
    service -> service : argon2id hash newPassword when present
    service -> db : BEGIN; UPDATE users (name, email, password_hash);\nUPDATE household.theme; COMMIT
    alt database failure
      db --> service : error
      service --> router : throws
      router --> client : 500 problem {requestId}
      client --> page : ApiError
      page --> parent : Show danger banner; keep values (L2-021)
    else committed
      db --> service : ok
      service --> router : SettingsView
      router --> client : 200 {account, theme}
      client --> page : SettingsView
      page -> session : update(name, color) for the parent (L2-021)
      page --> parent : Show "Saved" banner; clear password boxes
    end
  end
end
@enduml
