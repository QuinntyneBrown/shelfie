@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Edit household settings

class SettingsPage {
  +view: Signal<SettingsView | null>
  +state: Signal<'loading' | 'error' | 'default' | 'invalid' | 'submitting' | 'success'>
  +errors: Signal<FieldError[]>
  +needsCurrentPassword: Signal<boolean>
  +load(): Promise<void>
  +save(): Promise<void>
}

class "sh-color-picker" as ColorPicker {
  +colors: string[]
  +value: string
  +valueChange: EventEmitter<string>
}

class "sh-text-field" as TextField {
  +label: string
  +type: 'text' | 'email' | 'password'
  +error: string | null
}

class SettingsApi {
  +get(): Promise<SettingsView>
  +save(patch: SettingsPatch): Promise<SettingsView>
}

class SessionService {
  +session: Signal<Session | null>
  +update(name: string, color: string): void
}

class SettingsView {
  +reader: ReaderSettings
  +grownUp: GrownUpSettings
  +theme: 'device' | 'light' | 'dark'
}

class SettingsPatch {
  +reader: ReaderSettings
  +grownUp: GrownUpSettings
  +theme: 'device' | 'light' | 'dark'
}

class ReaderSettings {
  +name: string
  +color: string
  +pin?: string
}

class GrownUpSettings {
  +name: string
  +email: string
  +newPassword?: string
  +currentPassword?: string
}

class Profile {
  +id: string
  +householdId: string
  +role: 'reader' | 'grown_up'
  +name: string
  +color: string
  +email: string | null
  +passwordHash: string | null
  +pinHash: string | null
  +pinFailedCount: number
  +pinLockedUntil: Date | null
}

class SettingsService {
  +getSettings(householdId: string): SettingsView
  +updateSettings(householdId: string, profileId: string, patch: SettingsPatch): SettingsView
}

class SettingsRepo {
  +findHouseholdSettings(householdId: string): SettingsView
  +findProfileByEmail(email: string): Profile | undefined
  +updateReader(householdId: string, name: string, color: string, pinHash: string | null): void
  +updateGrownUp(profileId: string, name: string, email: string, passwordHash: string | null): void
  +updateTheme(householdId: string, theme: string): void
}

SettingsPage *-- ColorPicker : renders
SettingsPage *-- TextField : renders
SettingsPage ..> SettingsApi : calls
SettingsPage ..> SessionService : updates
SettingsApi ..> SettingsPatch : sends
SettingsApi ..> SettingsView : returns
SettingsView *-- ReaderSettings
SettingsView *-- GrownUpSettings
SettingsPatch *-- ReaderSettings
SettingsPatch *-- GrownUpSettings
SettingsService ..> SettingsPatch : receives
SettingsService --> SettingsRepo : uses
SettingsRepo --> Profile : reads / updates
Profile "2" --> "1" SettingsView : projected into
@enduml
