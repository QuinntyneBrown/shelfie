@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Edit household settings

class SettingsPage {
  +view: Signal<SettingsView | null>
  +state: Signal<'loading' | 'error' | 'default' | 'invalid' | 'submitting' | 'success'>
  +errors: Signal<FieldError[]>
  +needsCurrentPassword: Signal<boolean>
  +load(): Promise<void>
  +save(): Promise<void>
}

class "sh-text-field" as TextField {
  +label: string
  +type: 'text' | 'email' | 'password'
  +error: string | null
}

class SettingsApi {
  +get(): Promise<SettingsView>
  +save(patch: SettingsPatch): Promise<SettingsView>
}

class SessionService {
  +session: Signal<Session | null>
  +update(name: string, color: string): void
}

class SettingsView {
  +account: AccountSettings
  +theme: 'device' | 'light' | 'dark'
}

class SettingsPatch {
  +account: AccountPatch
  +theme: 'device' | 'light' | 'dark'
}

class AccountSettings {
  +name: string
  +username: string
  +email: string
}

class AccountPatch {
  +name: string
  +email: string
  +newPassword?: string
  +currentPassword?: string
}

class User {
  +id: string
  +householdId: string
  +role: 'parent' | 'reader'
  +name: string
  +username: string
  +email: string | null
  +passwordHash: string
}

class SettingsService {
  +getSettings(householdId: string, userId: string): SettingsView
  +updateSettings(householdId: string, userId: string, patch: SettingsPatch): SettingsView
}

class SettingsRepo {
  +findSettings(householdId: string, userId: string): SettingsView
  +findUserByEmail(email: string): User | undefined
  +updateParent(userId: string, name: string, email: string, passwordHash: string | null): void
  +updateTheme(householdId: string, theme: string): void
}

SettingsPage *-- TextField : renders
SettingsPage ..> SettingsApi : calls
SettingsPage ..> SessionService : updates
SettingsApi ..> SettingsPatch : sends
SettingsApi ..> SettingsView : returns
SettingsView *-- AccountSettings
SettingsPatch *-- AccountPatch
SettingsService ..> SettingsPatch : receives
SettingsService --> SettingsRepo : uses
SettingsRepo --> User : reads / updates
@enduml
