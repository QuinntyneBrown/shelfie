@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Edit household settings

Person(parent, "Parent", "Edits their own account")
System_Boundary(shelfie, "Shelfie") {
  Container(web, "Shelfie web", "Angular", "SettingsPage with the Your account section")
  Container(api, "Shelfie API", "Node.js, Express 5, TypeScript", "Verifies the current password, hashes the new password, writes the parent")
  ContainerDb(db, "Shelfie database", "SQLite", "users and household tables")
}
Rel(parent, web, "Edits and saves the form", "HTTPS")
Rel(web, api, "GET /api/settings, PATCH /api/settings", "JSON/HTTPS")
Rel(api, db, "Reads and updates the user row in one transaction", "SQL")
@enduml
