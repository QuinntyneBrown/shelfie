@startuml
title UML sequence behaviour — Send an invite
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as parent
box "Frontend — Shelfie web (settings library)" #E0F2FE
  participant "InviteParentDialog" as dialog
  participant "InvitesApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "invites.router.ts\n+ validate(inviteSchema)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "invites.service.ts" as service
  participant "mail.ts" as mail
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (SQLite)" as db
  participant "SMTP server (Mailpit)" as smtp
end box

parent -> dialog : Enter e-mail; tap Send invite
dialog -> dialog : Check e-mail format (L2-034)
alt e-mail is malformed
  dialog --> parent : Show "Fix 1 thing" and "Enter a valid e-mail."; send nothing
else e-mail is well formed
  dialog -> dialog : Set busy; disable form
  dialog -> client : send(email)
  client -> router : POST /api/invites {email}
  router -> router : Require parent role; validate body
  router -> service : createInvite(householdId, invitedBy, email)
  service -> service : Generate 32-byte token; hash with SHA-256;\nexpiry = now + 7 days (L2-034)
  service -> db : INSERT invites (token_hash, email, household_id, invited_by, expires_at)
  db --> service : ok
  service -> mail : sendMail(email, subject, text with link)
  mail -> smtp : Deliver message
  alt mail or database failure
    smtp --> mail : error
    mail --> service : throws
    service -> db : DELETE invites WHERE token_hash = ?
    service --> router : throws
    router --> client : 500 problem {requestId}
    client --> dialog : ApiError
    dialog --> parent : Show "The invite wasn't sent"; keep address; offer Try again (L2-034)
  else sent
    smtp --> mail : accepted
    mail --> service : ok
    service --> router : InviteView
    router --> client : 201 {id, email, sentAt, expiresAt}
    client --> dialog : InviteView
    dialog --> parent : Show "Invite sent" and "We e-mailed {address}."
  end
end
@enduml
