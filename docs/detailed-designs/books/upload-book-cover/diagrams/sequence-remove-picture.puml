@startuml
title UML sequence behaviour — Remove a cover picture
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Parent" as person
box "Frontend — Shelfie web" #E0F2FE
  participant "ManageBookPage\n+ sh-cover-picker" as page
  participant "BooksApi" as client
end box
box "Backend — Shelfie API" #D1FADF
  participant "covers.router.ts\n+ requireRole('parent')" as router
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box
person -> page : Remove picture
page -> page : Focus Add a picture before Remove picture goes
page -> client : removeCover(bookId)
client -> router : DELETE /api/books/{id}/cover
router -> router : Session (401); CSRF (403); reader → 403 grown-ups-only
router -> db : DELETE FROM book_cover WHERE book_id in household
alt failure
  router --> client : 500
  page --> person : Banner "The picture wasn’t removed" with Try again
else removed
  router --> client : 204
  page --> person : Header cover shows the colour and sticker again (L2-046)
end
@enduml
