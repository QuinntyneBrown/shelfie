@startuml
title UML sequence behaviour — Remove a question
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as grownUp
actor "Reader" as reader
box "Frontend — Shelfie web (books library)" #E0F2FE
  participant "ManageBookPage\n(Questions section)" as page
  participant "BooksApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "questions.router.ts\n+ requireRole('parent')" as router
  participant "chapters.router.ts\n(reading-log/log-chapter)" as chaptersRouter
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "questions.service.ts" as service
  participant "chapters.service.ts" as chapters
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

grownUp -> page : "Remove" on a custom question (defaults have no Remove — L2-013)
page -> client : removeQuestion(id)
client -> router : DELETE /api/questions/:id
router -> router : Require parent session (401 / 403)
router -> service : removeQuestion(householdId, questionId)
service -> db : SELECT question JOIN book WHERE question.id = ? AND household_id = ?
db --> service : row (404 when none or already removed)
alt server failure
  router --> client : 500 problem {requestId}
  client --> page : ApiError
  page --> grownUp : Error shown; question remains
else removed
  service -> db : UPDATE question SET removed_at = now WHERE id = ?
  db --> service : ok
  service --> router : void
  router --> client : 204
  client --> page : void
  page --> grownUp : Question dropped from the list
end
reader -> chaptersRouter : GET /api/books/:id/chapters/:n/form
chaptersRouter -> chapters : getForm(bookId, n)
chapters -> service : questionsForBook(bookId)
service -> db : SELECT text FROM question WHERE book_id = ?\nAND removed_at IS NULL ORDER BY created_at
db --> service : active custom texts
service --> chapters : DEFAULT_QUESTIONS + active custom texts (L2-013)
chapters --> reader : Form without the removed question;\nearlier answers keep their snapshot (L2-013)
@enduml
