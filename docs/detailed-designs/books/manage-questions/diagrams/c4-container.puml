@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Manage questions

Person(grownUp, "Grown-up", "Manages questions")
System_Boundary(shelfie, "Shelfie") {
  Container(web, "Shelfie web", "Angular", "Questions section of ManageBookPage; EditQuestionDialog")
  Container(api, "Shelfie API", "Node.js, Express 5, TypeScript", "DEFAULT_QUESTIONS constant; custom question endpoints; composes the log form")
  ContainerDb(db, "Shelfie database", "SQLite (better-sqlite3)", "question table; answer.question_text snapshots")
}
Rel(grownUp, web, "Adds, edits, removes a question", "HTTPS")
Rel(web, api, "POST /api/books/:id/questions, PATCH /api/questions/:id, DELETE /api/questions/:id", "JSON/HTTPS")
Rel(api, db, "Inserts, updates text, sets removed_at", "SQL")
@enduml
