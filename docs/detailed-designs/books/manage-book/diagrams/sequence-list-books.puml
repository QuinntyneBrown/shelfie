@startuml
title UML sequence behaviour — List the books
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as grownUp
box "Frontend — Shelfie web (books library)" #E0F2FE
  participant "BooksPage" as page
  participant "BooksApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "books.router.ts\n+ requireRole('parent')" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "books.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

grownUp -> page : Open /books
page -> page : Show sh-skeleton rows
page -> client : list()
client -> router : GET /api/books
router -> router : Require parent session (401 / 403)
router -> service : listBooks(householdId)
service -> db : SELECT book + COUNT(chapter_log), reward\nWHERE household_id = ?
db --> service : rows
service --> router : BookListItem[]
alt server failure
  router --> client : 500 problem {requestId}
  client --> page : ApiError
  page --> grownUp : sh-error-state "The books didn't load" with Try again
else no books
  router --> client : 200 []
  client --> page : []
  page --> grownUp : sh-empty-state "No books on Nia's shelf" with Add a book (L2-010)
else books present
  router --> client : 200 BookListItem[]
  client --> page : BookListItem[]
  page -> page : Derive status per book; summary line counts
  page --> grownUp : Rows with cover, progress, status badge, Manage link
  grownUp -> page : Manage
  page --> grownUp : Navigate to /manage-book/:id
end
@enduml
