@startuml
title UML sequence behaviour — Save a book's details
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Grown-up" as grownUp
box "Frontend — Shelfie web (books library)" #E0F2FE
  participant "ManageBookPage" as page
  participant "BooksApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "books.router.ts\n+ requireRole('grown-up')\n+ validate(updateBookSchema)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "books.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (SQLite)" as db
end box

grownUp -> page : Open /manage-book/:id
page -> client : get(id)
client -> router : GET /api/books/:id
router --> client : 200 BookResponse (view-book)
client --> page : BookResponse
page --> grownUp : Header, questions, chapters logged, Details form\nwith chapter floor help "can't go below N"
grownUp -> page : Edit title, author, chapter count; press Save changes
page -> page : Validate title present, chapterCount >= loggedCount
alt chapterCount below logged count
  page --> grownUp : "Enter N or more. Nia has already logged N chapters."; nothing sent (L2-010)
else valid on the client
  page -> page : Set submitting ("Saving…"); disable button
  page -> client : update(id, {title, author, chapterCount})
  client -> router : PATCH /api/books/:id
  router -> router : Require grown-up session; validate body
  router -> service : updateBook(householdId, bookId, patch)
  service -> db : SELECT book WHERE id = ? AND household_id = ?
  db --> service : book row (404 when none)
  service -> db : SELECT COUNT(*) FROM chapter_log WHERE book_id = ?
  db --> service : loggedCount
  alt chapterCount below loggedCount
    service --> router : ValidationError(chapterCount)
    router --> client : 400 problem errors[{field: "chapterCount"}]
    client --> page : ApiError
    page --> grownUp : Inline error on chapter count; nothing saved (L2-010)
  else server failure
    router --> client : 500 problem {requestId}
    client --> page : ApiError
    page --> grownUp : Error state; values kept
  else accepted
    service -> db : UPDATE book SET title, author, chapter_count
    db --> service : ok
    service --> router : BookResponse
    router --> client : 200 BookResponse
    client --> page : BookResponse
    page --> grownUp : "Saved just now"; shelf shows the change on next load (L2-010)
  end
end
@enduml
