@startuml
title UML sequence behaviour — View the shelf
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Reader" as reader
box "Frontend — Shelfie web (shelf library)" #E0F2FE
  participant "ShelfPage" as page
  participant "ShelfApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "shelf.router.ts\n+ requireRole(reader | parent)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "shelf.service.ts" as service
  participant "chapters.service.ts" as chapters
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

reader -> page : Open /shelf
page -> page : Show sh-skeleton placeholders (L2-007)
page -> client : shelf()
client -> router : GET /api/shelf
router -> router : Require session (401 without one)
router -> service : getShelf(householdId)
service -> db : SELECT book + COUNT(chapter_log), MAX(logged_at)\nWHERE household_id = ?
db --> service : books with progress
service -> db : SELECT reward WHERE book_id IN household books
db --> service : rewards
service -> db : SELECT chapter_log WHERE reviewed_at IS NOT NULL\nAND feedback_seen_at IS NULL
db --> service : unseen feedback
service -> chapters : streak(householdId) (reading-log/track-streak)
chapters --> service : streak days
service -> service : Group reading / upNext / finished;\nhero = reading book with latest logged_at
service --> router : ShelfResponse
alt server failure
  router --> client : 500 problem {requestId}
  client --> page : ApiError
  page --> reader : sh-error-state "Your shelf didn't load" with Try again (L2-007)
  reader -> page : Try again
  page -> client : shelf()
else no books
  router --> client : 200 {streak, hero: null, reading: [], upNext: [], finished: []}
  client --> page : ShelfResponse
  page --> reader : sh-empty-state "Your shelf is empty" with Add my first book (L2-007)
else books present
  router --> client : 200 ShelfResponse
  client --> page : ShelfResponse
  page -> page : Render hero, summary line with streak,\nsh-book-card grid 1-2 / 3 / 4+ columns (L2-007)
  page -> page : Render trophy shelf: reward text and date,\nor finished without reward (L2-018)
  page --> reader : Shelf shown
end
@enduml
