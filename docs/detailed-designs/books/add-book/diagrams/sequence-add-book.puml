@startuml
title UML sequence behaviour — Add a book
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Reader or Parent" as user
box "Frontend — Shelfie web (shelf library)" #E0F2FE
  participant "AddBookPage" as page
  participant "sh-cover (preview)" as preview
  participant "ShelfApi" as client
  participant "ToastService" as toast
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "books.router.ts\n+ requireRole(reader | parent)\n+ validate(createBookSchema)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "books.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

user -> page : Open /add-book from the shelf or the Books list (L2-009)
user -> page : Type title and author (input limited to 120 — L2-009),\nenter chapter count, pick colour and sticker
page -> preview : Update cover, title, author, "N chapters"
user -> page : Press "Add to my shelf"
page -> page : Validate title present, chapterCount integer 1..200
alt invalid
  page --> user : Summary "Fix N things" and field errors; nothing sent (L2-009)
else valid
  page -> page : Set submitting; disable button
  page -> client : addBook({title, author, chapterCount, coverColor, sticker})
  client -> router : POST /api/books
  router -> router : Require session; validate body (400 errors[] on failure)
  router -> service : createBook(householdId, profileId, body)
  service -> db : INSERT book (household_id, title, author, chapter_count,\ncover_color, sticker, added_by_profile_id)
  alt server failure
    db --> service : error
    service --> router : throw
    router --> client : 500 problem {requestId}
    client --> page : ApiError
    page --> user : "The book wasn't saved" with Try again; values kept (L2-009)
  else created
    db --> service : book row
    service --> router : Book
    router --> client : 201 {id, ...}
    client --> page : BookCreated
    page -> toast : success("{title} is on your shelf under Up next.") (L2-009)
    page --> user : Navigate to /book/:id; shelf lists the book under Up next (L2-009)
  end
end
@enduml
