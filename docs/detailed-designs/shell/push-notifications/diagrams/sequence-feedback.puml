@startuml
title UML sequence behaviour — A reader hears that a sticker, note or reward arrived
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as parent
actor "Reader device" as readerdev
box "Frontend — Shelfie web application" #E0F2FE
  participant "ReviewChapterPage" as page
end box
box "Backend — Shelfie API application" #D1FADF
  participant "reviewRouter" as router
end box
box "Backend — Shelfie Application and Domain" #ECFDF3
  participant "review.service" as review
  participant "push.service" as push
  participant "Push (web-push)" as sender
end box
box "Backend — Shelfie Infrastructure" #FFF4E5
  database "Shelfie database" as db
end box
parent -> page : Send sticker and note
page -> router : POST /api/chapter-logs/:id/feedback
router -> router : Authenticate, require parent
router -> review : sendFeedback(householdId, logId, sticker, note)
review -> db : Mark reviewed once
alt already reviewed
  db --> review : 0 rows
  review --> router : Problem 409 already-reviewed
  router --> page : 409 — nothing sent, L2-126 criterion 3
else saved
  db --> review : Saved
  review --> router : Result
  router --> page : 200
  router -> push : notify(household, reader, feedback, payload) — L2-126
  push -> db : Household switch feedback and reader subscriptions
  db --> push : Switch and targets
  opt switch on and at least one target
    loop each reader subscription
      push -> sender : send(target, "Dad read Chapter 9 and gave you a Star", tag feedback-id)
      sender -> readerdev : Web Push message
      sender --> push : sent, gone or error — L2-128
    end
  end
end
note over router, push
A book reward (L2-127) and a streak reward (L2-127) follow the same
path from their routes, with their own switch, title and tag.
end note
@enduml
