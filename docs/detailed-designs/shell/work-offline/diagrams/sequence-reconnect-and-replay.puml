@startuml
title UML sequence behaviour — Reconnect and replay the queue
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Reader" as reader
participant "Browser (Chromium)" as browser
box "Frontend — Shelfie web (core library)" #E0F2FE
  participant "OfflineQueue" as queue
  participant "ApiClient" as client
  participant "BannerService /\nToastService" as notify
end box
box "Frontend — Shelfie web (browser storage)" #E0F2FE
  database "IndexedDB\nshelfie-offline" as idb
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "chapters.router.ts\n+ sessionMiddleware, csrfGuard, validate()" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "chapters.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

browser -> queue : online event
queue -> queue : online.set(true)
queue -> notify : BannerService.clear(bannerId)
queue -> idb : getAll(pending-chapter-logs) ordered by id
idb --> queue : records
loop each record in id order (L2-024)
  queue -> client : post('/api/books/{bookId}/chapters/{n}', body)
  client -> router : POST /api/books/:id/chapters/:n\n(cookie shelfie_session, X-Requested-With: Shelfie)
  router -> service : logChapter(householdId, bookId, n, body)
  service -> db : INSERT chapter_log, answers
  alt Inserted
    db --> service : chapter_log row
    service --> router : ChapterLog
    router --> client : 201 {chapterLog}
    client --> queue : ChapterLog
    queue -> idb : delete(record.id)
    queue -> notify : ToastService.show(success "Chapter {n} saved") (L2-024)
  else UNIQUE(book_id, chapter_number) violated
    db --> service : constraint error
    service --> router : DuplicateChapter
    router --> client : 409 problem
    client --> queue : ApiError{status: 409}
    queue -> idb : delete(record.id) (already sent counts as success)
    queue -> notify : ToastService.show(success "Chapter {n} saved")
  else No response, 5xx, 401 or other 4xx
    client --> queue : ApiError{status: 0 | 5xx | 4xx}
    queue -> queue : Keep record; stop replay to preserve order (L2-024)
    queue -> notify : ToastService.show(danger "Couldn't send Chapter {n}", action Retry -> replay())
  end
end
opt Queue empty after replay
  queue -> notify : ToastService.show(success "Back online — Everything you logged has been sent.")
  notify --> reader : Toasts in the stack, newest nearest the edge
end
@enduml
