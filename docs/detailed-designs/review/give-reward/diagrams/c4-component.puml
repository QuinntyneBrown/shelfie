@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Give a reward

Container(web, "Shelfie web", "Angular", "ReviewPage opens GiveRewardDialog (sh-dialog); ReviewApi.giveReward")
Container_Boundary(api, "Shelfie API") {
  Component(router, "rewards.router.ts", "Express Router", "POST /api/books/:id/reward; validates with giveRewardSchema")
  Component(authz, "requireRole('grown_up')", "Middleware (authz.ts)", "401 without a session, 403 for a reader")
  Component(validate, "validate()", "Middleware (zod)", "Rejects empty or over-length text with 400")
  Component(service, "rewards.service.ts", "Service", "giveReward: 404 other household, 400 not finished, 409 reward exists, insert")
  Component(repo, "rewards.repo.ts", "Repository", "findBookForHousehold, findRewardByBook, insertReward")
  Component(booksRepo, "books.repo.ts / shelf.repo.ts", "Repositories (books, shelf modules)", "LEFT JOIN reward so book and shelf responses carry the reward")
  ComponentDb(db, "Shelfie database", "SQLite", "reward, book")
}
Rel(web, router, "POST /api/books/:id/reward", "JSON/HTTPS")
Rel(router, authz, "Applies")
Rel(router, validate, "Applies")
Rel(router, service, "giveReward(householdId, bookId, text, note, now)")
Rel(service, repo, "findBookForHousehold, findRewardByBook, insertReward")
Rel(repo, db, "Reads and writes", "SQL")
Rel(booksRepo, db, "Reads reward", "SQL")
@enduml
