@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Give a reward

Person(grownUp, "Grown-up", "Gives a reward")
System_Boundary(shelfie, "Shelfie") {
  Container(web, "Shelfie web", "Angular", "GiveRewardDialog on the Review page; reward shown on shelf, book and Manage book pages")
  Container(api, "Shelfie API", "Node.js, Express 5, TypeScript", "Checks the book is finished and unrewarded; inserts the reward")
  ContainerDb(db, "Shelfie database", "SQLite (better-sqlite3)", "reward and book tables")
}
Rel(grownUp, web, "Picks or types a reward, adds a note, saves", "HTTPS")
Rel(web, api, "POST /api/books/:id/reward", "JSON/HTTPS")
Rel(api, db, "Reads book, inserts reward (UNIQUE book_id)", "SQL")
@enduml
