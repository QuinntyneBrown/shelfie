@startuml
title UML sequence behaviour — Manage the gallery
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Parent" as parent
box "Frontend — Shelfie web (settings library)" #E0F2FE
  participant "SettingsPage" as page
  participant "GalleryRewardDialog" as dialog
  participant "GalleryRewardsApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "gallery.router.ts\n+ requireSession\n+ requireRole('parent')" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "gallery.service.ts" as service
end box
box "Backend — infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

parent -> page : Open Settings
page -> client : get() and list() together
client -> router : GET /api/gallery-rewards
router -> service : getGallery(householdId) (L2-084)
service -> db : SELECT gallery_reward WHERE household_id
router --> client : 200 { rewards, goal }
page --> parent : Rewards card: rows, or "No rewards yet" (L2-081)
parent -> dialog : Add a reward: "Trip to the zoo",\n"We'll see the penguins…", 3
dialog -> dialog : name 1–100 after trim, description 0–500 after trim,\ntarget whole 1–20; else "Fix N things", nothing sent (L2-081, L2-093)
dialog -> client : add({ name, description, target })
client -> router : POST /api/gallery-rewards
router -> router : reader → 403 grown-ups-only (L2-084);\nschema fails → 400 validation
router -> service : addGalleryReward
service -> db : INSERT gallery_reward
router --> client : 201 { id, name, target, description,\npictures: [], featuredPicture: null }
opt pictures chosen before Add reward (ADR-0010)
  dialog -> client : addPicture(id, file) for each, in order;\nfeaturePicture if another was made featured
  client -> router : POST /api/gallery-rewards/:id/pictures
  router --> client : 201 reward
end
dialog --> page : saved(reward)
page --> parent : Row added; toast "Trip to the zoo added"
alt edit
  parent -> dialog : Edit → change and save
  dialog -> client : update(id, input)
  client -> router : PATCH /api/gallery-rewards/:id
  router -> service : updateGalleryReward — other household → 404 (L2-084)
  service -> db : UPDATE … WHERE id AND household_id
  router --> client : 200 reward
  page --> parent : Row updated; toast "… saved" (L2-082)
else remove
  parent -> page : Remove → confirm "Remove reward"
  page -> client : remove(id)
  client -> router : DELETE /api/gallery-rewards/:id
  router -> service : removeGalleryReward
  service -> db : DELETE … WHERE id AND household_id\n(goal and reward_picture rows go with it: ON DELETE CASCADE)
  router --> client : 204
  page --> parent : Row gone; toast "… removed" (L2-083)
else server unreachable
  client --> dialog : ApiError status 0
  dialog --> parent : "… wasn’t saved" with Try again; values kept
end
@enduml
