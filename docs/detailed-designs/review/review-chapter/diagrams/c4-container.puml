@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Review a chapter

Person(grownUp, "Parent", "Sends feedback")
Person(reader, "Reader", "Sees feedback")
System_Boundary(shelfie, "Shelfie") {
  Container(web, "Shelfie web", "Angular", "ReviewChapterPage with sh-sticker-picker; ShelfPage with sh-banner")
  Container(api, "Shelfie API", "Node.js, Express 5, TypeScript", "Marks chapter logs reviewed; reports unseen feedback")
  ContainerDb(db, "Shelfie database", "SQLite (better-sqlite3)", "chapter_log and answer tables")
}
Rel(grownUp, web, "Picks a sticker, writes a note, sends", "HTTPS")
Rel(reader, web, "Opens shelf; follows the banner to the chapter", "HTTPS")
Rel(web, api, "GET /api/chapter-logs/:id, POST /api/chapter-logs/:id/feedback,\nGET /api/shelf, POST /api/chapter-logs/:id/seen", "JSON/HTTPS")
Rel(api, db, "Reads answers; updates reviewed_at, sticker, note, feedback_seen_at", "SQL")
@enduml
