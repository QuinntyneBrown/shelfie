@startuml
title UML sequence behaviour — Undo a chapter log
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Reader" as reader
box "Frontend — Shelfie web (log-chapter library)" #E0F2FE
  participant "sh-toast (Undo)" as toast
  participant "LogChapterPage" as page
  participant "DraftStore" as drafts
  participant "ChaptersApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "chapters.router.ts" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "chapters.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

reader -> toast : Press Undo while the toast is alive
toast -> page : undo()
page -> client : undo(chapterLogId)
client -> router : DELETE /api/chapter-logs/:id
router -> service : undoLog(householdId, chapterLogId)
service -> db : SELECT chapter_log JOIN book WHERE chapter_log.id = ? AND book.household_id = ?
db --> service : log row (404 when absent)
alt now before undo_until
  service -> db : DELETE answer WHERE chapter_log_id = ?; DELETE chapter_log WHERE id = ?
  db --> service : ok
  service --> router : Undone
  router --> client : 204
  client --> page : void
  page -> drafts : save(key, answers from the reverted log)
  page --> reader : Back to the form with answers restored; toast "Chapter N undone" (L2-011)
else undo_until has passed
  service --> router : UndoExpired
  router --> client : 409 problem type "undo-expired"
  client --> page : ApiError
  page --> reader : Toast "Too late to undo — answers are final" (L2-011)
end
@enduml
