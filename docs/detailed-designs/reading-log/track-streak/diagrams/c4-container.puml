@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Track the reading streak

Person(reader, "Reader", "Opens her shelf")
Person(grownUp, "Grown-up", "Opens Review")
System_Boundary(shelfie, "Shelfie") {
  Container(web, "Shelfie web", "Angular", "sh-streak-badge in the top bar, shelf hero line, Review streak tile")
  Container(api, "Shelfie API", "Node.js, Express 5, TypeScript", "Derives the streak from read_on days in the household time zone inside the shelf and review responses")
  ContainerDb(db, "Shelfie database", "SQLite (better-sqlite3)", "household.time_zone, chapter_log.read_on; nothing stores the streak")
}
Rel(reader, web, "Reads the streak", "HTTPS")
Rel(grownUp, web, "Reads the streak", "HTTPS")
Rel(web, api, "GET /api/shelf, GET /api/review", "JSON/HTTPS")
Rel(api, db, "SELECT DISTINCT read_on for the household", "SQL")
@enduml
