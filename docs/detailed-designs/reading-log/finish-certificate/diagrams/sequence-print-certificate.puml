@startuml
title UML sequence behaviour — Print a certificate
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Reader or parent" as user
box "Frontend — Shelfie web" #E0F2FE
  participant "BookPage / ReviewPage / ManageBookPage" as page
  participant "Browser" as browser
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "certificate.router.ts" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "certificate.service.ts" as service
  participant "books.service.ts / covers.service.ts" as data
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

user -> page : Press "Print certificate"
page -> browser : follow <a download href="/api/books/:id/certificate.pdf">
browser -> router : GET /api/books/:id/certificate.pdf (session cookie)
router -> service : renderCertificate(householdId, bookId)
service -> data : getBook(householdId, bookId)
data -> db : SELECT book, profile.name, household.time_zone
db --> data : rows
data --> service : BookResponse
alt book not found in this household
  service --> router : Problem 404 not-found
  router --> browser : 404 {type: "not-found"}
else finished_at is null
  service --> router : Problem 409 not-finished
  router --> browser : 409 {type: "not-finished"}
else finished
  service -> data : readCover(householdId, bookId)
  data -> db : SELECT image FROM book_cover
  db --> data : picture or none
  data --> service : BookCover | undefined
  service -> service : draw band, frame, name, title line, chapters line, long date, seal, picture (pdfkit)
  service --> router : Buffer
  router --> browser : 200 application/pdf, attachment "<reader>-<title>-certificate.pdf", private no-store, nosniff (L2-120)
  browser --> user : Saves the PDF to print
end
@enduml
