@startuml
title UML sequence behaviour — View chapter answers
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Reader" as reader
box "Frontend — Shelfie web (log-chapter library)" #E0F2FE
  participant "ChapterPage" as page
  participant "ChaptersApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "chapters.router.ts" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "chapters.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (SQLite)" as db
end box

reader -> page : Open a logged chapter row
page --> reader : Loading skeleton
page -> client : chapter(chapterLogId)
client -> router : GET /api/chapter-logs/:id
router -> service : getChapter(householdId, chapterLogId)
service -> db : SELECT chapter_log JOIN book WHERE chapter_log.id = ? AND book.household_id = ?
db --> service : log row (404 when absent)
service -> db : SELECT answer WHERE chapter_log_id = ? ORDER BY position
db --> service : answer rows
service --> router : ChapterView
alt load failure
  router --> client : 500 problem {requestId}
  client --> page : ApiError
  page --> reader : Error state with "Try again" and "Back to the book"
else loaded, reviewed_at null
  router --> client : 200 ChapterView {review: null}
  client --> page : ChapterView
  page --> reader : "Dad hasn't read this yet" + read-only answers (L2-012)
else loaded, reviewed
  router --> client : 200 ChapterView {review: {sticker, note, reviewedAt}, feedbackSeenAt}
  client --> page : ChapterView
  page --> reader : Sticker, note and read-only answers (L2-012)
  opt feedbackSeenAt null
    page -> client : markSeen(chapterLogId)
    client -> router : POST /api/chapter-logs/:id/seen
    router -> service : markFeedbackSeen(householdId, chapterLogId)
    service -> db : UPDATE chapter_log SET feedback_seen_at = now WHERE id = ? AND feedback_seen_at IS NULL
    db --> service : ok
    service --> router : done
    router --> client : 204 (shelf banner clears — L2-016, review/review-chapter)
    client --> page : void
  end
end
@enduml
