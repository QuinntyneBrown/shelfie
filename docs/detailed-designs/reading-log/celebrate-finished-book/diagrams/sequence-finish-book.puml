@startuml
title UML sequence behaviour — Finish a book
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Reader" as reader
box "Frontend — Shelfie web (log-chapter library)" #E0F2FE
  participant "LogChapterPage" as page
  participant "sh-celebration" as celebration
  participant "ChaptersApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "chapters.router.ts" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "chapters.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

reader -> page : Press "I'm done!" on chapter N of N
page -> client : log(bookId, n, request)
client -> router : POST /api/books/:id/chapters/:n
router -> service : logChapter(householdId, bookId, n, request)
service -> db : BEGIN; INSERT chapter_log and answers
service -> db : SELECT COUNT(*) FROM chapter_log WHERE book_id = ?
db --> service : count
alt count = book.chapter_count
  service -> db : UPDATE book SET finished_at = now WHERE id = ?; COMMIT
  db --> service : ok
  service --> router : LogChapterResult {bookFinished: true}
  router --> client : 201
  client --> page : LogChapterResult
  page -> celebration : Render finished state, variant book
  alt prefers-reduced-motion: reduce
    celebration --> reader : Trophy and heading at rest, no confetti (L2-019)
  else motion allowed
    celebration --> reader : Confetti for 2.5 s, then still (L2-019)
  end
  page --> reader : "You finished the whole book!" announced; Back to my shelf / Add my next book
else more chapters remain
  service -> db : COMMIT
  service --> router : LogChapterResult {bookFinished: false}
  router --> client : 201
  client --> page : LogChapterResult
  page --> reader : Ordinary success state (log-chapter)
end
@enduml
