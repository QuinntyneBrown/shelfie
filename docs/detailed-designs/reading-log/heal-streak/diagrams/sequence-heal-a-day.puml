@startuml
title UML sequence behaviour — Heal a missed day
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Parent" as parent
box "Frontend — Shelfie web (review library)" #E0F2FE
  participant "ReviewPage" as page
  participant "ReviewApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "streak-healing.router.ts" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "streak-healing.service.ts" as service
  participant "streak.ts" as streak
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

parent -> page : Open Review
page -> client : load()
client -> router : GET /api/review (review.router.ts)
router -> service : healOffer(householdId)
service -> db : SELECT healing_activity FROM household
service -> streak : readingDays(householdId) — read days, heals, today
service -> service : healableDays(): no chapter, 7 days before today, week unhealed (L2-161)
service --> page : heal: {day: Wednesday, activity}
page --> parent : "Heal a missed day" card with "Heal it"
parent -> page : Heal it
page -> client : heal(day)
client -> router : POST /api/streak-healing/heals {day}
router -> router : requireSession, requireRole('parent') (L2-164)
router -> service : healDay(householdId, day)
alt no activity, or the day is not healable
  service --> router : 400 not-healable
else
  service -> db : INSERT INTO streak_heal (household_id, healed_on, week_of, activity, healed_at)
  alt this week already has a heal (UNIQUE household_id, week_of)
    db --> service : unique violation
    service --> router : 409 already-healed-this-week
  else
    service -> streak : streakFor(householdId) — read days ∪ healed days
    streak --> service : streak
    service --> router : {day, streak}
    router --> client : 201 {day, streak}
    client --> page : {day, streak}
    page --> parent : card leaves, toast "Wednesday healed" · "Nia’s streak is 5 days."
  end
end
@enduml
