@startuml
title UML sequence behaviour — Sign in with a PIN
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Reader" as reader
box "Frontend — Shelfie web (sign-in library)" #E0F2FE
  participant "SignInPage" as page
  participant "sh-pin-keypad" as keypad
  participant "AuthApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "auth.router.ts\n+ validate(pinSignInSchema)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "auth.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (SQLite)" as db
end box

reader -> page : Tap reader profile
page -> keypad : Show PIN step
reader -> keypad : Enter 4 digits (digits only, max 4 — L2-001)
keypad -> page : complete(pin)
page -> client : signInWithPin(profileId, pin)
client -> router : POST /api/auth/pin {profileId, pin}
router -> router : Validate body; read shelfie_device cookie
router -> service : signInWithPin(householdId, profileId, pin)
service -> db : SELECT profile WHERE id = ?
db --> service : profile row
alt pin_locked_until in the future
  service --> router : PinLocked(lockedUntil)
  router --> client : 423 problem type "pin-locked" {lockedUntil}
  client --> page : ApiError
  page -> keypad : Show locked state with remaining time (L2-001)
else PIN does not match pin_hash
  service -> db : UPDATE profile SET pin_failed_count = +1,\npin_locked_until = (count = 5 ? now + 5 min : NULL)
  db --> service : ok
  service --> router : PinInvalid
  router --> client : 401 problem type "pin-invalid"
  client --> page : ApiError
  page -> keypad : Show inline error and clear digits (L2-001)
else PIN matches
  service -> db : UPDATE profile SET pin_failed_count = 0
  service -> db : INSERT session (profile_id, expires_at)
  db --> service : session row
  service --> router : Session
  router --> client : 200 {session} + Set-Cookie shelfie_session\n(HttpOnly, Secure, SameSite=Strict)
  client --> page : Session
  page -> page : SessionService.set(session)
  page --> reader : Navigate to /shelf (L2-001)
end
@enduml
