@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Sign in with a PIN

class SignInPage {
  +profiles: Signal<ProfileSummary[]>
  +step: Signal<'pick' | 'pin' | 'password'>
  +state: Signal<'idle' | 'submitting' | 'invalid' | 'locked' | 'error'>
  +lockedUntil: Signal<Date | null>
  +choose(profile: ProfileSummary): void
  +submitPin(pin: string): Promise<void>
}

class "sh-pin-keypad" as PinKeypad {
  +error: string | null
  +lockedUntil: Date | null
  +complete: EventEmitter<string>
}

class AuthApi {
  +profiles(): Promise<ProfileSummary[]>
  +signInWithPin(profileId: string, pin: string): Promise<Session>
}

class SessionService {
  +session: Signal<Session | null>
  +set(session: Session): void
}

class PinSignInRequest {
  +profileId: string
  +pin: string
}

class Profile {
  +id: string
  +householdId: string
  +role: 'reader' | 'grown_up'
  +name: string
  +color: string
  +pinHash: string | null
  +pinFailedCount: number
  +pinLockedUntil: Date | null
}

class Session {
  +id: string
  +profileId: string
  +createdAt: Date
  +expiresAt: Date
}

class AuthService {
  +signInWithPin(householdId: string, profileId: string, pin: string): Session
}

class AuthRepo {
  +findProfile(id: string): Profile | undefined
  +recordPinFailure(id: string, lockUntil: Date | null): void
  +resetPinFailures(id: string): void
  +createSession(profileId: string, expiresAt: Date): Session
}

SignInPage *-- PinKeypad : renders
SignInPage ..> AuthApi : calls
SignInPage ..> SessionService : sets
AuthApi ..> PinSignInRequest : sends
AuthService ..> PinSignInRequest : receives
AuthService --> AuthRepo : uses
AuthRepo --> Profile : reads / updates
AuthRepo --> Session : creates
Profile "1" --> "*" Session : owns
@enduml
