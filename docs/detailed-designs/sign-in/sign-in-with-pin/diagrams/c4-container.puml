@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Sign in with a PIN

Person(reader, "Reader", "Signs in with a 4-digit PIN")
System_Boundary(shelfie, "Shelfie") {
  Container(web, "Shelfie web", "Angular", "Sign-in page with profile picker and PIN keypad")
  Container(api, "Shelfie API", "Node.js, Express 5, TypeScript", "Verifies the PIN, applies the lockout, creates the session")
  ContainerDb(db, "Shelfie database", "SQLite (better-sqlite3)", "profile and session tables")
}
Rel(reader, web, "Taps her profile and enters the PIN", "HTTPS")
Rel(web, api, "POST /api/auth/pin", "JSON/HTTPS")
Rel(api, db, "Reads profile, updates failure count, inserts session", "SQL")
@enduml
