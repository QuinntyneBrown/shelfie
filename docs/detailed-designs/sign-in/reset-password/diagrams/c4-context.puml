@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Reset a forgotten password

Person(parent, "Parent", "Forgot the password; requests a reset link and chooses a new password")
System(shelfie, "Shelfie", "Reading log and comprehension questions for households of parents and readers")
System_Ext(mail, "E-mail provider", "Delivers the reset link")

Rel(parent, shelfie, "Requests a reset link and sets a new password", "HTTPS")
Rel(shelfie, mail, "Sends the reset link", "SMTP")
Rel(mail, parent, "Delivers the e-mail")
@enduml
