@startuml
title UML sequence behaviour — Reset the password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Grown-up" as grownUp
box "Frontend — Shelfie web (sign-in library)" #E0F2FE
  participant "ResetPasswordPage" as page
  participant "AuthApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "auth.router.ts\n+ validate(resetPasswordSchema)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "auth.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (SQLite)" as db
end box

grownUp -> page : Open /reset-password?token=...&email=... from the e-mail
page --> grownUp : "Choose a new password — For marcus@example.com"
grownUp -> page : Type new password twice; press Save new password
page -> page : Validate length >= 8 and match (L2-004)
alt too short or mismatch
  page --> grownUp : "Fix 2 things" summary and inline errors; no request (L2-004)
else form valid
  page -> client : resetPassword(token, password)
  client -> router : POST /api/auth/reset-password {token, password, confirm}
  router -> router : Validate body; read shelfie_device cookie
  router -> service : resetPassword(token, password, deviceId)
  service -> service : tokenHash = SHA-256(token)
  service -> db : SELECT password_reset WHERE token_hash = ?\nAND used_at IS NULL AND expires_at > now
  db --> service : row or none
  alt no row (unknown, used or expired)
    service --> router : ResetTokenInvalid
    router --> client : 400 problem type "reset-token-invalid"
    client --> page : ApiError
    page --> grownUp : "This link has expired" with Send a new link (L2-004)
  else row found
    service -> service : passwordHash = argon2id(password)
    service -> db : BEGIN; UPDATE profile SET password_hash = ?;\nUPDATE password_reset SET used_at = now;\nDELETE session WHERE profile_id = ? (L2-004);\nINSERT session; COMMIT
    db --> service : session row
    service --> router : SignInResult {session, device}
    router --> client : 200 {session} + Set-Cookie shelfie_session\n(+ Set-Cookie shelfie_device when absent)
    client --> page : Session
    page -> page : SessionService.set(session)
    page --> grownUp : "Password updated" with Go to Review (L2-004)
  else server unreachable or 5xx
    client --> page : ApiError or network failure
    page --> grownUp : Error summary with Try again; passwords kept
  end
end
@enduml
