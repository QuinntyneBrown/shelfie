@startuml
title UML sequence behaviour — Request a reset link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as parent
box "Frontend — Shelfie web (sign-in library)" #E0F2FE
  participant "ForgotPasswordPage" as page
  participant "AuthApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "auth.router.ts\n+ validate(forgotPasswordSchema)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "auth.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
  participant "E-mail provider (SMTP)" as mail
end box

parent -> page : Enter e-mail; press Send reset link
page -> page : Validate e-mail format
alt e-mail malformed
  page --> parent : "Check one thing" summary and field error; no request (L2-004)
else e-mail well-formed
  page -> client : forgotPassword(email)
  client -> router : POST /api/auth/forgot-password {email}
  router -> router : Validate body
  router -> service : requestPasswordReset(email)
  service -> db : SELECT users WHERE email = ? AND role = 'parent'
  db --> service : user row or none
  opt parent found
    service -> service : token = 32 random bytes; tokenHash = SHA-256(token)
    service -> db : INSERT password_reset (token_hash, user_id, expires_at = now + 1 h)
    db --> service : ok
    service -> mail : Send "Reset your Shelfie password" with\n/reset-password?token=...&email=...
    mail --> service : accepted
  end
  service --> router : done
  alt server unreachable or mail send failed
    router --> client : 5xx problem with requestId, or no response
    client --> page : ApiError or network failure
    page --> parent : "The e-mail couldn't be sent" with Try again; address kept
  else accepted
    router --> client : 202 (same body whether or not the account exists — L2-004)
    client --> page : done
    page --> parent : "Check your e-mail ... works for 1 hour" with send it again (L2-004)
  end
end
@enduml
