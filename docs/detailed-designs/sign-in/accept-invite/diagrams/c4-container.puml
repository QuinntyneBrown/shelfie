@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Accept an invite

Person(invitee, "Invited person", "Opens the link; chooses a name, username and password")
System_Boundary(shelfie, "Shelfie") {
  Container(web, "Shelfie web", "Angular", "Accept invite page in the sign-in library")
  Container(api, "Shelfie API", "Node.js, Express 5, TypeScript", "Looks up the invite by token hash, creates the parent, marks the invite used, opens a session")
  ContainerDb(db, "Shelfie database", "SQLite", "invites, household, profile, session and device tables")
}
Rel(invitee, web, "Opens /accept-invite?token=...", "HTTPS")
Rel(web, api, "GET /api/auth/invites/{token}, POST /api/auth/accept-invite", "JSON/HTTPS")
Rel(api, db, "Reads the invite; inserts profile and session; sets used_at", "SQL")
@enduml
