@startuml
title UML sequence behaviour — Open an invite link
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Invited person" as invitee
box "Frontend — Shelfie web (sign-in library)" #E0F2FE
  participant "AcceptInvitePage" as page
  participant "AuthApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "auth.router.ts" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "auth.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

invitee -> page : Open /accept-invite?token=... from the e-mail
page -> client : getInvite(token)
client -> router : GET /api/auth/invites/{token}
router -> service : getInvite(token)
service -> service : tokenHash = SHA-256(token)
service -> db : SELECT invites WHERE token_hash = ?
db --> service : row or none
alt row found, used_at IS NULL and expires_at in the future
  service --> router : InviteSummary {email, householdName, invitedBy}
  router --> client : 200 InviteSummary
  client --> page : InviteSummary
  page --> invitee : Form with e-mail fixed and household named (L2-035)
else unknown, used or expired
  service --> router : InviteInvalid
  router --> client : 400 problem type "invite-invalid"
  client --> page : ApiError
  page --> invitee : "This invite has expired" and Back to sign in (L2-035)
end
@enduml
