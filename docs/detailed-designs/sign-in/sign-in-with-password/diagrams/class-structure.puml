@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Sign in with a password

class SignInPage {
  +state: Signal<'idle' | 'submitting' | 'invalid' | 'error'>
  +username: FormControl<string>
  +password: FormControl<string>
  +remember: FormControl<boolean>
  +fieldErrors: Signal<Record<string, string>>
  +submit(): Promise<void>
  +retry(): Promise<void>
}

class "sh-text-field" as TextField {
  +label: string
  +type: 'text' | 'password'
  +error: string | null
  +autocomplete: string
}

class "sh-button" as Button {
  +variant: 'primary' | 'ghost'
  +busy: boolean
  +pressed: EventEmitter<void>
}

class AuthApi {
  +signInWithPassword(username: string, password: string, remember: boolean): Promise<Session>
}

class SessionService {
  +session: Signal<Session | null>
  +set(session: Session): void
}

class PasswordSignInRequest {
  +username: string
  +password: string
  +remember: boolean
}

class User {
  +id: string
  +householdId: string
  +role: 'parent' | 'reader'
  +name: string
  +username: string
  +passwordHash: string
}

class Session {
  +id: string
  +userId: string
  +role: 'parent' | 'reader'
  +createdAt: Date
  +expiresAt: Date
}

class AuthService {
  +signInWithPassword(username: string, password: string, remember: boolean): Session
}

class AuthRepo {
  +findUserByUsername(username: string): User | undefined
  +createSession(userId: string, expiresAt: Date): Session
}

SignInPage *-- TextField : renders
SignInPage *-- Button : renders
SignInPage ..> AuthApi : calls
SignInPage ..> SessionService : sets
AuthApi ..> PasswordSignInRequest : sends
AuthService ..> PasswordSignInRequest : receives
AuthService --> AuthRepo : uses
AuthRepo --> User : reads
AuthRepo --> Session : creates
User "1" --> "*" Session : owns
@enduml
