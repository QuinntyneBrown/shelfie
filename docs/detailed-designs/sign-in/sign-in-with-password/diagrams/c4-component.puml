@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Sign in with a password

Container(web, "Shelfie web", "Angular", "SignInPage with sh-text-field and sh-button; AuthApi")
Container_Boundary(api, "Shelfie API") {
  Component(router, "auth.router.ts", "Express Router", "POST /api/auth/password; validates body with passwordSignInSchema")
  Component(limiter, "rate-limit.ts", "Middleware", "Rate limits sign-in failures per source, then 429")
  Component(validate, "validate()", "Middleware (zod)", "Rejects malformed bodies with 400")
  Component(service, "auth.service.ts", "Service", "signInWithPassword: case-insensitive lookup, argon2id verify, generic failure, session creation")
  Component(repo, "auth.repo.ts", "Repository", "Parameterised SQL over users and session")
  ComponentDb(db, "Shelfie database", "PostgreSQL 16", "users, session")
}
Rel(web, router, "POST /api/auth/password", "JSON/HTTPS")
Rel(router, limiter, "Applies")
Rel(router, validate, "Applies")
Rel(router, service, "signInWithPassword(username, password, remember)")
Rel(service, repo, "findUserByUsername, createSession")
Rel(repo, db, "Reads and writes", "SQL")
@enduml
