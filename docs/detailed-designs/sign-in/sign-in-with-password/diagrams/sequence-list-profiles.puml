@startuml
title UML sequence behaviour — List profiles for the picker
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Grown-up" as grownUp
box "Frontend — Shelfie web (sign-in library)" #E0F2FE
  participant "SignInPage" as page
  participant "AuthApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "auth.router.ts" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "auth.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (SQLite)" as db
end box

grownUp -> page : Open /sign-in
page -> client : profiles()
client -> router : GET /api/auth/profiles
router -> router : Read shelfie_device cookie; verify HMAC signature
alt cookie absent or signature invalid
  router --> client : 200 []
  client --> page : []
  page --> grownUp : Show password form with e-mail and password fields
else cookie valid
  router -> service : listProfiles(deviceId)
  service -> db : SELECT device WHERE id = ?
  db --> service : device row
  service -> db : SELECT profile WHERE household_id = ?
  db --> service : reader and grown-up rows
  service --> router : ProfileSummary[]
  router --> client : 200 [{id, role, name, color, email}]
  client --> page : ProfileSummary[]
  page --> grownUp : Show picker; pre-focus last-used profile
end
@enduml
