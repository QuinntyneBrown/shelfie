@startuml
title UML sequence behaviour — Sign in as a parent or a reader
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent or reader" as person
box "Frontend — Shelfie web (sign-in library)" #E0F2FE
  participant "SignInPage" as page
  participant "sh-button" as button
  participant "AuthApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "auth.router.ts\n+ rate limit + validate(passwordSignInSchema)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "auth.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

person -> page : Type username and password; set Remember me; press Sign in or Enter
page -> page : Validate non-empty username and password (L2-002)
alt a field is empty
  page --> person : Field-level errors; no request sent (L2-002)
else form valid
  page -> button : busy = true (second press sends nothing — L2-002)
  page -> client : signInWithPassword(username, password, remember)
  client -> router : POST /api/auth/password {username, password, remember}
  alt rate limit exceeded
    router --> client : 429 problem type "rate-limited"
    client --> page : ApiError
    page --> person : Error summary with rate-limit copy
  else body valid
    router -> service : signInWithPassword(username, password, remember)
    service -> db : SELECT users WHERE username = ? (case-insensitive)
    db --> service : user row or none
    service -> service : argon2id verify (dummy hash when no row)
    alt no user or password mismatch
      service --> router : CredentialsInvalid
      router --> client : 401 problem type "credentials-invalid"
      client --> page : ApiError
      page --> person : Generic "Username or password is wrong"; keep username (L2-002)
    else password matches
      service -> db : INSERT session (user_id, expires_at by remember)
      db --> service : session row
      service --> router : Session with role
      router --> client : 200 {session} + Set-Cookie shelfie_session
      client --> page : Session
      page -> page : SessionService.set(session)
      alt role is parent
        page --> person : Navigate to Review (L2-002)
      else role is reader
        page --> person : Navigate to her shelf (L2-002)
      end
    end
  else server unreachable or 5xx
    client --> page : ApiError or network failure
    page --> person : Error state "Can’t reach Shelfie" with Try again (L2-002)
  end
end
@enduml
