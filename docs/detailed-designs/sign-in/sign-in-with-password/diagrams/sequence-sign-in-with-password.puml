@startuml
title UML sequence behaviour — Sign in with a password
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Grown-up" as grownUp
box "Frontend — Shelfie web (sign-in library)" #E0F2FE
  participant "SignInPage" as page
  participant "sh-button" as button
  participant "AuthApi" as client
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "auth.router.ts\n+ rateLimit + validate(passwordSignInSchema)" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "auth.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (SQLite)" as db
end box

grownUp -> page : Tap grown-up profile
page --> grownUp : Show password step with e-mail fixed
grownUp -> page : Type password; press Sign in or Enter
page -> page : Validate e-mail format and non-empty password (L2-002)
alt a field is invalid
  page --> grownUp : Field-level errors; no request sent (L2-002)
else form valid
  page -> button : busy = true (second press sends nothing — L2-002)
  page -> client : signInWithPassword(email, password)
  client -> router : POST /api/auth/password {email, password}
  alt more than 10 attempts in 10 minutes from this source
    router --> client : 429 problem type "rate-limited"
    client --> page : ApiError
    page --> grownUp : Error summary: Too many tries. Wait 10 minutes and try again.
  else body valid
    router -> router : Validate body; read shelfie_device cookie
    router -> service : signInWithPassword(email, password, deviceId)
    service -> db : SELECT profile WHERE email = ? AND role = 'grown_up'
    db --> service : profile row or none
    service -> service : argon2id verify (dummy hash when no row)
    alt no profile or password mismatch
      service --> router : CredentialsInvalid
      router --> client : 401 problem type "credentials-invalid"
      client --> page : ApiError
      page --> grownUp : Generic "e-mail or password is wrong"; keep password; focus summary (L2-002)
    else password matches
      service -> db : INSERT session (profile_id, expires_at)
      db --> service : session row
      opt deviceId absent or from another household
        service -> db : INSERT device (household_id)
        db --> service : device row
      end
      service --> router : SignInResult {session, device}
      router --> client : 200 {session} + Set-Cookie shelfie_session\n(+ Set-Cookie shelfie_device, 1 year, when created)
      client --> page : Session
      page -> page : SessionService.set(session)
      page --> grownUp : Navigate to /review (L2-002)
    end
  else server unreachable or 5xx
    client --> page : ApiError or network failure
    page --> grownUp : Error state "Shelfie isn't reachable right now" with Try again (L2-002)
  end
end
@enduml
