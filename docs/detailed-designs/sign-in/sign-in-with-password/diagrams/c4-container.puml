@startuml
!include <C4/C4_Container>
LAYOUT_WITH_LEGEND()
title Containers — Sign in with a password

Person(parent, "Parent", "Signs in with username and password")
Person(reader, "Reader", "Signs in with username and password")
System_Boundary(shelfie, "Shelfie") {
  Container(web, "Shelfie web", "Angular", "Sign-in page with username, password and Remember me")
  Container(api, "Shelfie API", "Node.js, Express 5, TypeScript", "Verifies the password, creates the session, sets the session cookie")
  ContainerDb(db, "Shelfie database", "PostgreSQL 16 (pg)", "users and session tables")
}
Rel(parent, web, "Enters credentials", "HTTPS")
Rel(reader, web, "Enters credentials", "HTTPS")
Rel(web, api, "POST /api/auth/password", "JSON/HTTPS")
Rel(api, db, "Reads user, inserts session", "SQL")
@enduml
