@startuml
title UML sequence behaviour — Add a reward
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as parent
box "Frontend — Shelfie web (onboarding library)" #E0F2FE
  participant "OnboardingPage" as page
  participant "OnboardingApi" as client
end box
box "Backend — Shelfie API (Express routers)" #D1FADF
  participant "gallery.router.ts" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "gallery.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

parent -> page : Tap "Trip to the zoo"; 3 books; Add another or Next (L2-141)
page -> page : Validate name 1 to 100, books 1 to 20
page -> client : addReward({name, target, description: ''})
client -> router : POST /api/gallery-rewards
router -> router : requireSession, requireRole('parent'), galleryRewardSchema
router -> service : addGalleryReward(householdId, input)
service -> db : INSERT gallery_reward
db --> service : row
service --> router : GalleryReward
router --> client : 201 GalleryReward
client --> page : reward
alt Add another
  page --> parent : Reward listed; fields cleared; stay on the step
else Next
  page --> parent : Navigate to /onboarding/done (L2-142)
end
@enduml
