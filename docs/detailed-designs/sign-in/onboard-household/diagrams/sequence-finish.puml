@startuml
title UML sequence behaviour — Finish or skip
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as parent
box "Frontend — Shelfie web (onboarding library)" #E0F2FE
  participant "OnboardingPage" as page
  participant "OnboardingApi" as client
  participant "SessionService" as session
end box
box "Backend — Shelfie API (Express routers)" #D1FADF
  participant "settings.router.ts" as router
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

alt Go to my shelf on All set (L2-142)
  parent -> page : Go to my shelf
else Skip for now on steps 1 to 4 (L2-138)
  parent -> page : Skip for now
end
page -> client : finish()
client -> router : POST /api/settings/onboarded
router -> router : requireSession, requireRole('parent')
router -> db : UPDATE household SET onboarded = TRUE WHERE id = session household
db --> router : 1 row
router --> client : 204
client --> page : done
page -> session : update({onboarded: true})
page --> parent : Navigate to /review (L2-137)
@enduml
