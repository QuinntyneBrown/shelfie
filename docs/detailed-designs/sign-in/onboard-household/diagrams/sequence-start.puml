@startuml
title UML sequence behaviour — Start the wizard after sign-up
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Parent" as parent
box "Frontend — Shelfie web (sign-in and onboarding libraries)" #E0F2FE
  participant "SignUpPage" as signup
  participant "SessionService" as session
  participant "OnboardingPage" as page
end box
box "Backend — Shelfie API (Express routers)" #D1FADF
  participant "auth.router.ts" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "auth.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

parent -> signup : Create my account
signup -> router : POST /api/auth/sign-up
router -> service : signUp(input)
service -> db : INSERT household (onboarded = FALSE); INSERT profile; INSERT session
db --> service : rows
service --> router : Session {onboarded: false}
router --> signup : 201 session + cookie
signup -> session : current.set(session)
alt session.onboarded is false (L2-137)
  signup --> parent : Navigate to /onboarding
  parent -> page : Welcome step, Step 1 of 5 (L2-138)
else accept-invite or an onboarded household
  signup --> parent : Navigate to /review
end
@enduml
