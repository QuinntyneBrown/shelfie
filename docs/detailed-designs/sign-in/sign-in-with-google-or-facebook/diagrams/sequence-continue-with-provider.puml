@startuml
title UML sequence behaviour — Continue with a provider
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
actor "Parent" as person
box "Frontend — Shelfie web (sign-in library)" #E0F2FE
  participant "SignInPage / SignUpPage" as page
  participant "sh-button + sh-provider-icon" as button
  participant "AuthApi" as client
end box
box "Backend — Shelfie API (routers and middleware)" #D1FADF
  participant "auth.router.ts\n+ providerSignInLimiter" as router
end box
box "Backend — Shelfie API (modules and services)" #ECFDF3
  participant "oauth.ts" as oauth
  participant "auth.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box
participant "Google or Facebook" as provider #FDF2FA

page -> client : providers()
client -> router : GET /api/auth/providers
router --> client : {providers: [google, facebook]} (names only — L2-142)
client --> page : configured providers
page --> person : Divider and one button per provider; none when empty (L2-137)
person -> page : Press Continue with Google (Keep me signed in as set)
page -> button : busy = true; second press sends nothing (L2-137)
page -> router : location.assign /api/auth/google/start?remember=1&from=sign-in (L2-141)
router -> router : state and verifier from randomBytes(32); S256 challenge (L2-142)
router -> router : Set-Cookie shelfie_oauth {provider, state, verifier, remember, from}\nHttpOnly, Secure, Lax, 10 min
router -> oauth : authorizeUrl(google, redirect_uri, state, challenge)
router --> person : 302 to the provider's consent screen
person -> provider : Consent (name and verified e-mail only)
provider --> person : 302 /api/auth/google/callback?code=…&state=…
person -> router : GET /api/auth/google/callback (cookie shelfie_oauth sent, Lax)
router -> router : Clear shelfie_oauth; state must equal the cookie's (L2-142)
router -> oauth : exchangeCode(google, code, verifier, redirect_uri)
oauth -> provider : POST token endpoint {code, code_verifier, client_id, client_secret}
provider --> oauth : {id_token, access_token}
oauth -> oauth : Read id_token payload; aud = client id (Google)\nor GET /me?fields=id,name,email (Facebook)
oauth --> router : ProviderIdentity {subject, email, verified, name}
router -> service : signInWithProvider(google, identity, remember)
service -> db : SELECT profile_provider WHERE provider, subject
alt link exists
  db --> service : profile (L2-138)
else no link, verified parent e-mail
  service -> db : SELECT profile WHERE email = lower(email) AND role = parent
  service -> db : INSERT profile_provider (L2-138)
else no link, no profile
  service -> db : INSERT household, profile (name, e-mail, generated username, no password), profile_provider (L2-139)
end
service -> db : INSERT session (remember)
service --> router : Session
router -> db : DELETE the browser's previous session
router --> person : 302 /review + Set-Cookie shelfie_session (remembered or not — L2-141)
person -> page : /review loads; SessionService.restore()
page --> person : Review
@enduml
