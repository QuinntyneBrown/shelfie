@startuml
!include <C4/C4_Context>
LAYOUT_WITH_LEGEND()
title System Context — Authorize access

Person(reader, "Reader", "May open her shelf, books and chapters; never grown-up areas")
Person(grownUp, "Grown-up", "May open Review, Books, Manage book and Settings")
