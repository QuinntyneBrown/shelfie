@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage a session

Container(web, "Shelfie web", "Angular", "SessionService, ApiClient, sh-menu account menu; AuthApi")
Container_Boundary(api, "Shelfie API") {
  Component(sessionMw, "session.ts", "Middleware", "sessionMiddleware: resolves shelfie_session to a row; deletes expired rows and flags req.sessionExpired")
  Component(router, "auth.router.ts", "Express Router", "GET /api/auth/session; POST /api/auth/sign-out")
  Component(app, "app.ts", "Express app", "Sets Cache-Control: no-store on every /api response")
  Component(service, "auth.service.ts", "Service", "currentSession, signOut")
  Component(repo, "auth.repo.ts", "Repository", "findSession, deleteSession, deleteExpiredSessions")
  ComponentDb(db, "Shelfie database", "SQLite", "session, profile")
}
Rel(web, app, "Every /api request", "JSON/HTTPS")
Rel(app, sessionMw, "Applies before routers")
Rel(sessionMw, repo, "findSession, deleteSession")
Rel(app, router, "Routes /api/auth")
Rel(router, service, "currentSession(sessionId), signOut(sessionId)")
Rel(service, repo, "findSession, deleteSession")
Rel(repo, db, "Reads and writes", "SQL")
@enduml
