@startuml
!include <C4/C4_Component>
LAYOUT_WITH_LEGEND()
title Components — Manage a session

Container(web, "Shelfie web", "Angular", "SessionService, sessionExpiredInterceptor, sh-menu account menu")
Container_Boundary(api, "Shelfie API") {
  Component(app, "app.ts", "Express app", "Sets Cache-Control: no-store on /api responses")
  Component(sessionMw, "session.ts", "Middleware", "requireSession: resolves shelfie_session to a row; slides a remembered session; deletes an expired row and answers 401 session-expired")
  Component(router, "auth.router.ts", "Express Router", "GET /api/auth/session; POST /api/auth/sign-out")
  ComponentDb(db, "Shelfie database", "PostgreSQL 16", "session, users")
}
Rel(web, app, "Every /api request", "JSON/HTTPS")
Rel(app, router, "Routes /api/auth")
Rel(router, sessionMw, "Applies requireSession to GET /session")
Rel(sessionMw, db, "Selects, updates expires_at, deletes expired rows", "SQL")
Rel(router, db, "Deletes the session row on sign-out", "SQL")
@enduml
