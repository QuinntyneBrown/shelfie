@startuml
title UML sequence behaviour — Restore and expire a session
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Reader or grown-up" as person
box "Frontend — Shelfie web (core and sign-in libraries)" #E0F2FE
  participant "SessionService" as sessionSvc
  participant "ApiClient" as client
  participant "SignInPage" as page
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "sessionMiddleware" as mw
  participant "auth.router.ts" as router
end box
box "Backend — Shelfie API (services)" #ECFDF3
  participant "auth.service.ts" as service
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (SQLite)" as db
end box

person -> sessionSvc : Open the app (provideAppInitializer runs restore())
sessionSvc -> client : GET /api/auth/session
client -> mw : Request with shelfie_session cookie
mw -> db : SELECT session WHERE id = ?
db --> mw : session row or none
alt no cookie or no row
  mw --> client : 401 problem type "no-session" (Cache-Control: no-store)
  client -> sessionSvc : clear()
  sessionSvc --> person : Protected routes redirect to /sign-in
else expires_at in the past (30 days without activity, L2-003)
  mw -> db : DELETE session WHERE id = ?
  db --> mw : ok
  mw --> client : 401 problem type "session-expired" + expired Set-Cookie
  client -> sessionSvc : clear()
  client -> page : Navigate to /sign-in?reason=expired
  page --> person : Picker with "You were signed out" banner (L2-003)
else session valid
  mw -> router : req.session set
  router -> service : currentSession(sessionId)
  service -> db : SELECT profile WHERE id = ?
  db --> service : profile row
  service --> router : Session summary
  router --> client : 200 {householdId, profileId, role, name, color}
  client --> sessionSvc : Session
  sessionSvc --> person : Requested page renders
end
@enduml
