@startuml
title UML sequence behaviour — Sign out
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam rectangle {
  BorderColor #344054
  FontColor #101828
}
skinparam package {
  BorderColor #667085
  FontColor #101828
  BackgroundColor #F9FAFB
}
actor "Reader or parent" as person
box "Frontend — Shelfie web (components, core and sign-in libraries)" #E0F2FE
  participant "sh-menu\n(account menu)" as menu
  participant "ApiClient" as client
  participant "SessionService" as sessionSvc
  participant "authGuard" as guard
  participant "SignInPage" as page
end box
box "Backend — Shelfie API (Express routers and middleware)" #D1FADF
  participant "auth.router.ts\n+ csrfGuard" as router
end box
box "Backend — Shelfie infrastructure" #FFF4E5
  database "Shelfie database (PostgreSQL)" as db
end box

person -> menu : Open avatar menu (Enter, Space or ArrowDown)
person -> menu : Choose "Sign out"
menu -> sessionSvc : signOut()
sessionSvc -> client : POST /api/auth/sign-out
client -> router : Request with shelfie_session cookie
router -> router : csrfGuard
router -> db : DELETE session WHERE id = ? (L2-003)
db --> router : ok
router --> client : 204 + cleared shelfie_session cookie\n(Cache-Control: no-store)
client --> sessionSvc : done
note right of sessionSvc : The in-memory session is cleared\neven when the call fails
sessionSvc -> sessionSvc : current = null
menu -> page : Navigate to /sign-in
page --> person : Sign-in form (L2-003)
person -> guard : Press Back to the previous protected route
guard -> sessionSvc : current() is null
guard -> page : Redirect to /sign-in; no protected data shown (L2-003)
@enduml
