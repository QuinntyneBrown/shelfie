@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Manage a session

class SessionService {
  +current: Signal<Session | null>
  +expired: Signal<boolean>
  +restore(): Promise<void>
  +signOut(): Promise<void>
}

class sessionExpiredInterceptor <<HttpInterceptorFn>> {
  +intercept(request, next): Observable
}

class "sh-menu" as Menu {
  +open: boolean
  +items: MenuItem[]
  +select: EventEmitter<MenuItem>
  +close(): void
}

class SignInPage {
  +reason: Signal<'expired' | null>
  +rememberMe: FormControl<boolean>
}

class Session {
  +userId: string
  +householdId: string
  +role: 'reader' | 'parent'
  +name: string
  +color: string
}

class SessionRow {
  +id: string
  +userId: string
  +remember: boolean
  +createdAt: Date
  +expiresAt: Date
}

class requireSession <<Express middleware>> {
  +requireSession(db): RequestHandler
}

class AuthRouter {
  +GET /session
  +POST /sign-out
}

SessionService --> Session : holds
sessionExpiredInterceptor ..> SessionService : clears, sets expired
sessionExpiredInterceptor ..> SignInPage : navigates to with reason
Menu ..> SessionService : signOut on Sign out
requireSession --> SessionRow : reads / slides / deletes
AuthRouter ..> requireSession : applies
AuthRouter --> SessionRow : deletes on sign-out
@enduml
