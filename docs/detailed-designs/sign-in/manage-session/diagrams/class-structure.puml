@startuml
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam roundcorner 8
skinparam defaultFontName Arial
skinparam ArrowColor #344054
skinparam class {
  BorderColor #344054
  FontColor #101828
  BackgroundColor #F9FAFB
}
title Class structure — Manage a session

class SessionService {
  +session: Signal<Session | null>
  +restored: Promise<void>
  +restore(): Promise<void>
  +set(session: Session): void
  +clear(): void
}

class ApiClient {
  +get<T>(path: string): Promise<T>
  +post<T>(path: string, body: unknown): Promise<T>
  -handleUnauthorized(problem: Problem): void
}

class AuthApi {
  +session(): Promise<Session>
  +signOut(): Promise<void>
}

class "sh-menu" as Menu {
  +open: boolean
  +items: MenuItem[]
  +select: EventEmitter<MenuItem>
  +close(): void
}

class SignInPage {
  +reason: Signal<'expired' | null>
}

class Session {
  +householdId: string
  +profileId: string
  +role: 'reader' | 'grown-up'
  +name: string
  +color: string
}

class SessionRow {
  +id: string
  +profileId: string
  +createdAt: Date
  +expiresAt: Date
}

class SessionMiddleware {
  +handle(req: Request, res: Response, next: NextFunction): void
}

class AuthService {
  +currentSession(sessionId: string): Session
  +signOut(sessionId: string): void
}

class AuthRepo {
  +findSession(id: string): SessionRow | undefined
  +deleteSession(id: string): void
  +deleteExpiredSessions(now: Date): number
}

SessionService ..> AuthApi : restores through
AuthApi --> ApiClient : uses
ApiClient ..> SessionService : clears on 401
ApiClient ..> SignInPage : navigates to with reason
Menu ..> AuthApi : signOut on Sign out / Switch reader
SessionService --> Session : holds
SessionMiddleware --> AuthRepo : uses
AuthService --> AuthRepo : uses
AuthRepo --> SessionRow : reads / deletes
@enduml
